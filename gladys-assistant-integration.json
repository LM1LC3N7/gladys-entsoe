    {
      "key": "test_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Read the prices now",
        "fr": "Lire les prix maintenant"
      },
      "description": {
        "en": "Reads today's and tomorrow's prices and shows the current one (also after a refused token).",
        "fr": "Lit les prix d'aujourd'hui et de demain et affiche le prix actuel (aussi après un jeton refusé)."
      }
    }
  ]
