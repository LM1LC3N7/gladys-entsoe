    {
      "key": "vat_percent",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 50,
      "label": {
        "en": "VAT (%)",
        "fr": "TVA (%)"
      },
      "description": {
        "en": "Added to every price: (spot + fixed fees) × (1 + VAT). 0 keeps the wholesale price.",
        "fr": "Ajoutée à chaque prix : (spot + frais fixes) × (1 + TVA). 0 garde le prix de gros."
      }
    },
    {
      "key": "fees_per_kwh",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 1,
      "label": {
        "en": "Fixed fees (EUR/kWh)",
        "fr": "Frais fixes (€/kWh)"
      },
      "description": {
        "en": "Added to the spot price of every kWh before VAT (supplier margin, grid fees, taxes).",
        "fr": "Ajoutés au prix spot de chaque kWh avant TVA (marge du fournisseur, réseau, taxes)."
      },
      "placeholder": {
        "en": "e.g. 0.12",
        "fr": "ex. 0.12"
      }
    },
    {
      "key": "timezone",
      "type": "string",
      "required": false,
      "default": "Europe/Paris",
      "label": {
        "en": "Gladys timezone",
        "fr": "Fuseau horaire de Gladys"
      },
      "description": {
        "en": "The timezone of your Gladys (Settings → System): it sets the days and the times shown. IANA name, e.g. Europe/Brussels.",
        "fr": "Le fuseau de votre Gladys (Paramètres → Système) : il fixe les jours et les heures affichées. Nom IANA, ex. Europe/Brussels."
      },
      "placeholder": {
        "en": "Europe/Paris",
        "fr": "Europe/Paris"
      }
    }
