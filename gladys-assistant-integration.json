{
  "manifest_version": 1,
  "type": "device",
  "name": "ENTSO-E",
  "description": {
    "en": "Unofficial connector: ENTSO-E day-ahead electricity prices for Europe, per kWh.",
    "fr": "Connecteur non officiel : prix spot ENTSO-E du lendemain en Europe, au kWh."
  },
  "version": "0.1.1",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-entsoe:0.1.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-entsoe/main/cover.png",
  "categories": ["energy"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "ENTSO-E day-ahead prices",
        "fr": "Prix ENTSO-E du lendemain"
      },
      "description": {
        "en": "Unofficial connector, not affiliated with ENTSO-E. It reads the day-ahead prices of one European bidding zone on the ENTSO-E Transparency Platform with your free security token: one device with the current and next price per kWh, the lowest, highest and average price of the day, the cheapest period of today and tomorrow, and the rank of the current period. Wholesale prices: your supplier adds its margin, the grid fees and the taxes; the VAT and fixed fees below are added for you.",
        "fr": "Connecteur non officiel, sans lien avec ENTSO-E. Il lit les prix du lendemain d'une zone de marché européenne sur la plateforme de transparence ENTSO-E avec votre jeton de sécurité gratuit : un appareil avec le prix actuel et suivant au kWh, les prix minimum, maximum et moyen du jour, la période la moins chère d'aujourd'hui et de demain, et le rang de la période actuelle. Prix de gros : votre fournisseur ajoute sa marge, les frais de réseau et les taxes ; la TVA et les frais fixes ci-dessous sont ajoutés pour vous."
      },
      "links": [
        {
          "url": "https://transparency.entsoe.eu/",
          "label": {
            "en": "ENTSO-E Transparency Platform",
            "fr": "Plateforme de transparence ENTSO-E"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-entsoe/blob/main/docs/en.md",
          "label": {
            "en": "Guide and free token (English)",
            "fr": "Guide et jeton gratuit (anglais)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-entsoe/blob/main/docs/fr.md",
          "label": {
            "en": "Guide and free token (French)",
            "fr": "Guide et jeton gratuit (français)"
          }
        }
      ]
    },
    {
      "key": "security_token",
      "type": "secret",
      "required": true,
      "label": {
        "en": "ENTSO-E security token",
        "fr": "Jeton de sécurité ENTSO-E"
      },
      "description": {
        "en": "Kept by Gladys in its database (in clear, masked in the interface), never shown again, and only sent to ENTSO-E.",
        "fr": "Gardé par Gladys dans sa base (en clair, masqué dans l'interface), jamais réaffiché, et envoyé seulement à ENTSO-E."
      },
      "placeholder": {
        "en": "e.g. 1d9cd4bd-f8aa-476c-8cc1-3442dc91506d",
        "fr": "ex. 1d9cd4bd-f8aa-476c-8cc1-3442dc91506d"
      }
    },
    {
      "key": "zone",
      "type": "select",
      "required": true,
      "default": "FR",
      "label": {
        "en": "Bidding zone",
        "fr": "Zone de marché"
      },
      "description": {
        "en": "The day-ahead market zone of your meter. Changing it creates a new device.",
        "fr": "La zone du marché du lendemain de votre compteur. La changer crée un nouvel appareil."
      },
